{
  "name": "typein",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "typein": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prettier/html-tags": "^2.2.0",
    "known-css-properties": "^0.37.0",
    "terser": "^5.49.0",
    "yaml": "^2.9.0"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "semi": false,
    "endOfLine": "lf",
    "experimentalTernaries": true,
    "proseWrap": "never",
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "**/*.ts",
        "options": {
          "parser": "typescript"
        }
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx"
        ],
        "options": {
          "tabWidth": 4
        }
      }
    ]
  }
}
